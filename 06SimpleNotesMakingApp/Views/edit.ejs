<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <h2>edit</h2>

     <div class="main w-full min-h-screen p-10 text-zinc-600 ">
        
        <a class="text-blue-500 inline-block mb-10s" href="/">Go Back to Home</a>

        <form  action="/edit" method="post">
           
            <input class="block w-1/4 rounded-md outline-none px-5 py-2 mt-3 bg-zinc-900 text-white" type="text"
                name="previous_title" placeholder="Previous Title goes here" value="<%= filename %>" />
           
            <input class="block w-1/4 rounded-md outline-none px-5 py-2 mt-3 bg-zinc-900 text-white" type="text"
                name="new_title" placeholder="New Title goes here" />
           
            <input class="text-black mt-2 bg-yellow-400 px-5 py-2 rounded-md mt-3" type="submit" value="Create task">
        </form>

    </div>
</body>
</html>