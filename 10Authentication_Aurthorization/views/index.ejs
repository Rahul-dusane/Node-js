<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>
    <div class="w-full h-screen text-zinc-900 p-10"> Create User
        <form action="/create" method="post">
            <input class="px-3 py-2 rounded-md bg-zinc-900 text-white mt-2 outline-none" type="text" name="username" placeholder="Username" /><br>
            <input class="px-3 py-2 rounded-md bg-zinc-900 text-white mt-2 outline-none" type="email" name="email" placeholder="Email" /><br>
            <input class="px-3 py-2 rounded-md bg-zinc-900 text-white mt-2 outline-none" type="password" name="password" placeholder="Password" /><br>
            <input class="px-3 py-2 rounded-md bg-zinc-900 text-white mt-2 outline-none" type="number" name="age" placeholder="Age" /><br>
            <input class="px-5 py-2 rounded-md bg-blue-500 mt-2" type="submit" value="Create" /><br>
        </form>
    </div>
</body>
</html>