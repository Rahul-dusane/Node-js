<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>

</head>
<body>

    <div class="w-full min-h-screen font-bold p-10">
        
        <div class="w-full flex justify-end ">
            <a href="/logout" class="bg-red-500 rounded-md text-white px-3 py-2 text-sm mb-5 inline-block">Logout</a>
        </div>

        <h2 class="mb-5">You can edit your post</h2>
        
        <form action="/update/<%= post._id %>" method="post">
            <textarea placeholder="What`s in the mind ?" class="w-1/3 p-3 outline-none  resize-none bg-transparent border-2 border-zinc-800 rounded-md bg-zinc-800 text-white" name="content" ><%= post.content %></textarea>
            <input type="submit" class="px-3 py-2 bg-yellow-400 hover:bg-yellow-500 text-white font-bold block rounded-md mt-2 w-52" value="Edit Post" />
        </form>

    </div>
    
</body>
</html>