<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body>
    <div class="w-full min-h-screen p-10">
        <h2 class="text-3xl mb-5">Login User</h2>
        <form action="/login" method="post">
            <input class="px-3 py-2 outline-none bg-zinc-800 rounded-lg mt-2 text-white " type="email" placeholder="Email" name="email" /><br>
            <input class="px-3 py-2 outline-none bg-zinc-800 rounded-lg mt-2 text-white " type="password" placeholder="Password" name="password" /><br>
            <input class="px-3 py-2 outline-none bg-blue-600 rounded-lg mt-2 text-white hover:bg-blue-800 " type="submit" value="Login" /><br>
        </form>
    </div>
    
</body>
</html>