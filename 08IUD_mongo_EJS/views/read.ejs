<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Document</title>
    <link rel="stylesheet" href="../public/stylesheets/style.css">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>

<body>
    <div class="w-full h-full text-zinc-900 p-10"></div>
    
    <a class="text-blue-500" href="/">Go to home</a>
    
    <h1 class="text-3xl mt-10 tracking-tighter mb-3">All Users</h1>
    
    <div class="users flex gap-3 flex-wrap">
        
        <div class="user max-w-72 p-4 rounded-lg bg-zinc-800">
            <div class="w-full h-52 rounded-lg bg-zinc-800"></div>
            <h3 class="text-2xl text-white tracking-tighter">Xyz Sharma</h3>
            <h5 class="text-white">xyz@123.com</h5>
            <div class="flex gap-3 mt-10">
                <a class="text-white" href="">Edit User</a>
                <a class="text-red-500" href="">Delete User</a>
            </div>
        </div>
        <% users.forEach(function(val){ %>
            <div class="user max-w-72 p-4 rounded-lg bg-zinc-800">
                <div class="w-full h-52 rounded-lg bg-zinc-800">
                    <img src="<%= val.image%>" alt="" />
                </div>
                <h3 class="text-2xl text-white tracking-tighter"><%= val.name %></h3>
                <h5 class="text-white"><%= val.email %></h5>
                <div class="flex gap-3 mt-10">
                    <a class="text-white" href="/edit/<%= val._id %>">Edit User</a>
                    <a class="text-red-500" href="/delete/<%= val._id %>">Delete User</a>
                </div>
            </div>
       <% }) %>
     

        
    </div>

</body>

</html>